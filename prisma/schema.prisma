generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SolveHistory {
  id              String   @id @default(cuid())
  question        String
  subject         String
  mode            String
  provider        String?
  givenData       String
  requiredToFind  String
  formulaUsed     String
  stepwiseSolution String
  finalAnswer     String
  shortcutMethod  String
  practiceProblem String
  bookmarked      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FormulaItem {
  id        String   @id @default(cuid())
  title     String
  subject   String
  formula   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RevisionNote {
  id        String   @id @default(cuid())
  title     String
  subject   String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PracticeAttempt {
  id        String   @id @default(cuid())
  subject   String
  prompt    String
  answer    String?
  correct   Boolean?
  createdAt DateTime @default(now())
}
